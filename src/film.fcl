FUNCTION_BLOCK consigliatore

// 1. Definisci le variabili di input
VAR_INPUT
    voto_critica : REAL; // Da 0 a 10
    popolarita : REAL;   // Da 0 a 100 (milioni di views o index)
END_VAR


// 2. Definisci le variabili di output
VAR_OUTPUT
    consiglio : REAL; // Da 0 a 10 (quanto te lo consiglio)
END_VAR


//-----------------------------------------------------------------------


// 3. Fuzzificazione: trasforma i numeri in concetti linguistici
FUZZIFY voto_critica
    TERM pessimo := (0, 1) (4, 0);
    TERM mediocre := (3, 0) (5, 1) (7, 0);
    TERM eccellente := (6, 0) (9, 1);
END_FUZZIFY

FUZZIFY popolarita
    TERM nicchia := (0, 1) (30, 0);
    TERM media := (20, 0) (50, 1) (80, 0);
    TERM blockbuster := (70, 0) (100, 1);
END_FUZZIFY


// 4. Defuzzificazione: dal concetto linguistico al numero finale
DEFUZZIFY consiglio
    TERM evitare := (0, 1) (3, 0);
    TERM guardabile := (2, 0) (5, 1) (8, 0);
    TERM imperdibile := (7, 0) (10, 1);
    METHOD : COG; // Center of Gravity (metodo standard)
    DEFAULT := 0;
END_DEFUZZIFY

// 5. Regole di inferenza (La logica vera e propria)
// qui si cambiano i connettivi
RULEBLOCK No1
    AND : MIN;
    ACT : MIN;
    ACCU : MAX;

    RULE 1 : IF voto_critica IS pessimo THEN consiglio IS evitare;
    RULE 2 : IF voto_critica IS eccellente AND popolarita IS nicchia THEN consiglio IS imperdibile; // Gemme nascoste
    RULE 3 : IF voto_critica IS mediocre AND popolarita IS blockbuster THEN consiglio IS guardabile;
    RULE 4 : IF voto_critica IS eccellente AND popolarita IS blockbuster THEN consiglio IS imperdibile;
END_RULEBLOCK

END_FUNCTION_BLOCK