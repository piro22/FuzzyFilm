FUNCTION_BLOCK calcolo_affinita

// INPUT: Differenza tra richiesta Utente e Dati Film (convertiti in 0-10)
VAR_INPUT
    complessita : REAL;
    complessita_film : REAL;
END_VAR

VAR_OUTPUT
    affinita_complessita : REAL;
END_VAR


// --- DEFINIZIONE TERMINI ---
FUZZIFY complessita
    TERM semplice := gauss 1.5 0.8;
    TERM lineare := gauss 4.0 0.9;
    TERM intricata := gauss 6.5 0.8;
    TERM cerebrale := gauss 8.8 0.9;
END_FUZZIFY

FUZZIFY complessita_film
    TERM semplice := (0, 1) (1, 1) (2, 0);
    TERM lineare := (2, 0) (3, 1) (4.5, 0);
    TERM intricata := (3.5, 0) (5, 1) (6, 0);
    TERM cerebrale := (6, 0) (7, 1) (8, 1);
END_FUZZIFY



DEFUZZIFY affinita_complessita
    TERM scartare := (0, 0) (0, 1) (0.15, 1) (0.4, 0);
    TERM considerare := gauss 0.5 0.15;
    TERM imperdibile := (0.6, 0) (0.85, 1) (1, 1) (1, 0);
    METHOD : COG;
    DEFAULT := 0;
END_DEFUZZIFY



RULEBLOCK Rules
    AND : MIN;
    ACCU : MAX;

    // -----------------------------------------------------------------
    // CASO 1: VOGLIO RELAX (complessità richiesta: SEMPLICE)
    // -----------------------------------------------------------------

    // Se voglio spegnere il cervello, un film semplice è perfetto
    RULE 1 : IF complessita IS semplice
             AND complessita_film IS semplice
             THEN affinita_complessita IS imperdibile;

    // Un film lineare (trama classica) lo posso gestire anche se sono stanco
    RULE 2 : IF complessita IS semplice
             AND complessita_film IS lineare
             THEN affinita_complessita IS considerare;

    // Se voglio relax, evitare assolutamente trame intricate o cervellotiche
    RULE 3 : IF complessita IS semplice
             AND (complessita_film IS intricata OR complessita_film IS cerebrale)
             THEN affinita_complessita IS scartare;


    // -----------------------------------------------------------------
    // CASO 2: VOGLIO UNA STORIA STANDARD (complessità richiesta: LINEARE)
    // -----------------------------------------------------------------

    // Cerco una bella storia classica (inizio-svolgimento-fine chiari)
    RULE 4 : IF complessita IS lineare
             AND complessita_film IS lineare
             THEN affinita_complessita IS imperdibile;

    // Accetto sia qualcosa di molto leggero, sia qualcosa di un po' più pepato
    RULE 5 : IF complessita IS lineare
             AND (complessita_film IS semplice OR complessita_film IS intricata)
             THEN affinita_complessita IS considerare;

    // Evito i film troppo pesanti/filosofici, rovinerebbero la serata "standard"
    RULE 6 : IF complessita IS lineare
             AND complessita_film IS cerebrale
             THEN affinita_complessita IS scartare;


    // -----------------------------------------------------------------
    // CASO 3: VOGLIO UN INTRIGO (complessità richiesta: INTRICATA)
    // -----------------------------------------------------------------

    // Voglio stare attento ai dettagli, cerco trame fitte (thriller, gialli)
    RULE 7 : IF complessita IS intricata
             AND complessita_film IS intricata
             THEN affinita_complessita IS imperdibile;

    // Se il film è troppo semplice mi annoio, meglio scartarlo
    RULE 8 : IF complessita IS intricata
             AND complessita_film IS semplice
             THEN affinita_complessita IS scartare;

    // Una storia lineare è un "piano B", oppure un film "cerebrale" se mi sento coraggioso
    RULE 9 : IF complessita IS intricata
             AND (complessita_film IS lineare OR complessita_film IS cerebrale)
             THEN affinita_complessita IS considerare;


    // -----------------------------------------------------------------
    // CASO 4: VOGLIO SFIDARMI (complessità richiesta: CEREBRALE)
    // -----------------------------------------------------------------

    // Voglio film alla Nolan/Lynch, cose che devo rivedere due volte
    RULE 10 : IF complessita IS cerebrale
              AND complessita_film IS cerebrale
              THEN affinita_complessita IS imperdibile;

    // Un film intricato va bene, ma forse è troppo "facile" per il mio mood attuale
    RULE 11 : IF complessita IS cerebrale
              AND complessita_film IS intricata
              THEN affinita_complessita IS considerare;

    // Se sono in mood "filosofico", i film semplici o lineari sono tempo perso
    RULE 12 : IF complessita IS cerebrale
              AND (complessita_film IS semplice OR complessita_film IS lineare)
              THEN affinita_complessita IS scartare;

END_RULEBLOCK

END_FUNCTION_BLOCK