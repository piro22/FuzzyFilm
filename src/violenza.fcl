FUNCTION_BLOCK calcolo_affinita

// input violenza dell'utente e contenuto del film
VAR_INPUT
    violenza : REAL;
    violenza_film : REAL;
END_VAR

VAR_OUTPUT
    affinita : REAL;
END_VAR

FUZZIFY violenza
    TERM per_tutti := (0, 1) (1, 1) (3, 0);
    TERM moderato := (2, 0) (5, 1) (8, 0);
    TERM esplicito := (7, 0) (9, 1) (10, 1);
END_FUZZIFY

FUZZIFY violenza_film
    TERM per_tutti := (0, 1) (1, 1) (3, 0);
    TERM moderato := (2, 0) (5, 1) (8, 0);
    TERM esplicito := (7, 0) (9, 1) (10, 1);
END_FUZZIFY

DEFUZZIFY affinita
    TERM scartare := (0, 1) (0.4, 0);
    TERM considerare := (0.3, 0) (0.5, 1) (0.7, 0);
    TERM imperdibile := (0.6, 0) (1, 1);
    METHOD : COG;
    DEFAULT := 0;
END_DEFUZZIFY

RULEBLOCK Rules
    AND : MIN;
    ACCU : MAX;


    // PREFERENZA: PER TUTTI
    RULE 1 : IF violenza IS per_tutti AND violenza_film IS per_tutti
             THEN affinita IS imperdibile;

    RULE 2 : IF violenza IS per_tutti AND violenza_film IS moderato
             THEN affinita IS considerare;

    RULE 3 : IF violenza IS per_tutti AND violenza_film IS esplicito
             THEN affinita IS scartare;

    // PREFERENZA: MODERATO
    RULE 4 : IF violenza IS moderato AND violenza_film IS moderato
             THEN affinita IS imperdibile;

    RULE 5 : IF violenza IS moderato AND violenza_film IS per_tutti
             THEN affinita IS considerare;

    RULE 6 : IF violenza IS moderato AND violenza_film IS esplicito
             THEN affinita IS scartare;

    // PREFERENZA: ESPLICITO
    RULE 7 : IF violenza IS esplicito AND violenza_film IS esplicito
             THEN affinita IS imperdibile;

    RULE 8 : IF violenza IS esplicito AND violenza_film IS moderato
             THEN affinita IS considerare;

    RULE 9 : IF violenza IS esplicito AND violenza_film IS per_tutti
             THEN affinita IS scartare;

END_RULEBLOCK

END_FUNCTION_BLOCK