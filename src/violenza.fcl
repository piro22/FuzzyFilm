FUNCTION_BLOCK calcolo_affinita

// input violenza dell'utente e contenuto del film
VAR_INPUT
    violenza : REAL;
    violenza_film : REAL;
END_VAR

VAR_OUTPUT
    affinita : REAL;
END_VAR

FUZZIFY violenza
    TERM per_tutti := (0, 1) (1, 1) (2, 0);
    TERM lieve := (1, 0) (3, 1) (5, 0);
    TERM moderato := (4, 0) (5.5, 1) (7, 0);
    TERM forte := (6, 0) (7.5, 1) (9, 0);
    TERM estremo := (8, 0) (9, 1) (10, 1);
END_FUZZIFY

FUZZIFY violenza_film
    TERM per_tutti := (0, 1) (1, 1) (2, 0);
    TERM lieve := (1, 0) (3, 1) (5, 0);
    TERM moderato := (4, 0) (5.5, 1) (7, 0);
    TERM forte := (6, 0) (7.5, 1) (9, 0);
    TERM estremo := (8, 0) (9, 1) (10, 1);
END_FUZZIFY

DEFUZZIFY affinita
    TERM scartare := (0, 1) (0.4, 0);
    TERM considerare := (0.3, 0) (0.5, 1) (0.7, 0);
    TERM imperdibile := (0.6, 0) (1, 1);
    METHOD : COG;
    DEFAULT := 0;
END_DEFUZZIFY

RULEBLOCK Rules
    AND : MIN;
    ACCU : MAX;

    // PREFERENZA: PER TUTTI
    RULE 1 : IF violenza IS per_tutti AND violenza_film IS per_tutti
             THEN affinita IS imperdibile;
    RULE 2 : IF violenza IS per_tutti AND violenza_film IS lieve
             THEN affinita IS considerare;
    RULE 3 : IF violenza IS per_tutti AND violenza_film IS moderato
             THEN affinita IS scartare;
    RULE 4 : IF violenza IS per_tutti AND violenza_film IS forte
             THEN affinita IS scartare;
    RULE 5 : IF violenza IS per_tutti AND violenza_film IS estremo
             THEN affinita IS scartare;

    // PREFERENZA: LIEVE
    RULE 6 : IF violenza IS lieve AND violenza_film IS per_tutti
             THEN affinita IS considerare;
    RULE 7 : IF violenza IS lieve AND violenza_film IS lieve
             THEN affinita IS imperdibile;
    RULE 8 : IF violenza IS lieve AND violenza_film IS moderato
             THEN affinita IS considerare;
    RULE 9 : IF violenza IS lieve AND violenza_film IS forte
             THEN affinita IS scartare;
    RULE 10 : IF violenza IS lieve AND violenza_film IS estremo
              THEN affinita IS scartare;

    // PREFERENZA: MODERATO
    RULE 11 : IF violenza IS moderato AND violenza_film IS per_tutti
              THEN affinita IS considerare;
    RULE 12 : IF violenza IS moderato AND violenza_film IS lieve
              THEN affinita IS considerare;
    RULE 13 : IF violenza IS moderato AND violenza_film IS moderato
              THEN affinita IS imperdibile;
    RULE 14 : IF violenza IS moderato AND violenza_film IS forte
              THEN affinita IS considerare;
    RULE 15 : IF violenza IS moderato AND violenza_film IS estremo
              THEN affinita IS scartare;

    // PREFERENZA: FORTE
    RULE 16 : IF violenza IS forte AND violenza_film IS per_tutti
              THEN affinita IS scartare;
    RULE 17 : IF violenza IS forte AND violenza_film IS lieve
              THEN affinita IS considerare;
    RULE 18 : IF violenza IS forte AND violenza_film IS moderato
              THEN affinita IS considerare;
    RULE 19 : IF violenza IS forte AND violenza_film IS forte
              THEN affinita IS imperdibile;
    RULE 20 : IF violenza IS forte AND violenza_film IS estremo
              THEN affinita IS considerare;

    // PREFERENZA: ESTREMO
    RULE 21 : IF violenza IS estremo AND violenza_film IS per_tutti
              THEN affinita IS scartare;
    RULE 22 : IF violenza IS estremo AND violenza_film IS lieve
              THEN affinita IS scartare;
    RULE 23 : IF violenza IS estremo AND violenza_film IS moderato
              THEN affinita IS considerare;
    RULE 24 : IF violenza IS estremo AND violenza_film IS forte
              THEN affinita IS considerare;
    RULE 25 : IF violenza IS estremo AND violenza_film IS estremo
              THEN affinita IS imperdibile;

END_RULEBLOCK

END_FUNCTION_BLOCK