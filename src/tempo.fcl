FUNCTION_BLOCK calcolo_affinita

// INPUT: Differenza tra richiesta Utente e Dati Film (convertiti in 0-10)
VAR_INPUT
    tempo_a_disposizione : REAL;
    durata_film : REAL;
END_VAR

VAR_OUTPUT
    affinita : REAL;
END_VAR


// --- DEFINIZIONE TERMINI ---
FUZZIFY tempo_a_disposizione
    TERM poco := (0, 1) (2, 1) (3, 0);
    TERM medio := (2, 0) (4, 1) (6, 0);
    TERM tanto := (5, 0) (10, 1);
END_FUZZIFY

FUZZIFY durata_film
    TERM bassa := (0, 1) (30, 1) (70, 0);
    TERM media := (60, 0) (70, 1) (90, 1) (140, 0);
    TERM alta := (120, 0) (150, 1) (180, 0);
    TERM altissima := (170, 0) (200, 1) (240, 1);
END_FUZZIFY



DEFUZZIFY affinita
    TERM scartare := (0, 1) (0.4, 0);
    TERM considerare := (0.3, 0) (0.5, 1) (0.7, 0);
    TERM imperdibile := (0.6, 0) (1, 1);
    METHOD : COG;
    DEFAULT := 0;
END_DEFUZZIFY


RULEBLOCK Rules
    AND : MIN;
    ACCU : MAX;

    // -----------------------------------------------------------------
    // CASO 1: HO POCO TEMPO (es. < 1 ora o indice basso)
    // -----------------------------------------------------------------

    // Se ho poco tempo, posso guardare solo cose brevi (corti o film brevissimi)
    RULE 1 : IF tempo_a_disposizione IS poco
             AND durata_film IS bassa
             THEN affinita IS imperdibile;

    // Se ho poco tempo, qualsiasi cosa media, lunga o lunghissima è impossibile da finire
    RULE 2 : IF tempo_a_disposizione IS poco
             AND (durata_film IS media OR durata_film IS alta OR durata_film IS altissima)
             THEN affinita IS scartare;


    // -----------------------------------------------------------------
    // CASO 2: HO TEMPO MEDIO (es. una serata standard)
    // -----------------------------------------------------------------

    // Il film "medio" (90-110 min) è perfetto per una serata standard
    RULE 3 : IF tempo_a_disposizione IS medio
             AND durata_film IS media
             THEN affinita IS imperdibile;

    // Se il film è molto breve, va bene lo stesso (mi avanza tempo), ma non è l'uso "ottimo"
    RULE 4 : IF tempo_a_disposizione IS medio
             AND durata_film IS bassa
             THEN affinita IS considerare;

    // Se il film è lungo o lunghissimo, rischio di non finirlo o fare troppo tardi
    RULE 5 : IF tempo_a_disposizione IS medio
             AND (durata_film IS alta OR durata_film IS altissima)
             THEN affinita IS scartare;


    // -----------------------------------------------------------------
    // CASO 3: HO TANTO TEMPO (es. weekend, giorno libero)
    // -----------------------------------------------------------------

    // Se ho tanto tempo, i film lunghi o lunghissimi (es. Interstellar, Avatar) sono la scelta migliore
    RULE 6 : IF tempo_a_disposizione IS tanto
             AND (durata_film IS alta OR durata_film IS altissima)
             THEN affinita IS imperdibile;

    // Un film di durata media va bene, ma forse volevo un'esperienza più impegnativa
    RULE 7 : IF tempo_a_disposizione IS tanto
             AND durata_film IS media
             THEN affinita IS considerare;

    // Se ho 3-4 ore libere e guardo un corto di 10 minuti, è un po' deludente (oppure "scartare" se vuoi essere drastico)
    RULE 8 : IF tempo_a_disposizione IS tanto
             AND durata_film IS bassa
             THEN affinita IS scartare;

END_RULEBLOCK

END_FUNCTION_BLOCK