FUNCTION_BLOCK calcolo_affinita

// INPUT: Differenza tra richiesta Utente e Dati Film (convertiti in 0-10)
VAR_INPUT
    fantasia : REAL;
    fantasia_film : REAL;
END_VAR

VAR_OUTPUT
    affinita : REAL;
END_VAR


// --- DEFINIZIONE TERMINI ---
FUZZIFY fantasia
    TERM realistico := (0, 1) (2, 1) (3, 0);
    TERM stilizzato := (2, 0) (4, 1) (6, 0);
    TERM surreale := (5, 0) (7, 1) (8, 0);
    TERM fantasy := (7, 0) (8, 1) (10, 1);
END_FUZZIFY

FUZZIFY fantasia_film
    TERM realistico := (0, 1) (0.5, 1) (1, 0);
    TERM stilizzato := (1, 0) (1.5, 1) (2, 0);
    TERM surreale := (2, 0) (2.5, 1) (3, 0);
    TERM fantasy := (3, 0) (3.5, 1) (4, 0);
END_FUZZIFY



DEFUZZIFY affinita
    TERM scartare := (0, 1) (0.4, 0);
    TERM considerare := (0.3, 0) (0.5, 1) (0.7, 0);
    TERM imperdibile := (0.6, 0) (1, 1);
    METHOD : COG;
    DEFAULT := 0;
END_DEFUZZIFY


RULEBLOCK Rules_Fantasia
    AND : MIN;
    ACCU : MAX;

    // -----------------------------------------------------------------
    // CASO 1: VOGLIO LA CRUDA REALTÀ (User: REALISTICO)
    // -----------------------------------------------------------------

    // Cerco storie vere, biopic, drammi concreti. Niente magia.
    RULE 1 : IF fantasia IS realistico
             AND fantasia_film IS realistico
             THEN affinita IS imperdibile;

    // Un film "stilizzato" (es. colori particolari, regia artistica) è accettabile,
    // purché non ci siano draghi o alieni.
    RULE 2 : IF fantasia IS realistico
             AND fantasia_film IS stilizzato
             THEN affinita IS considerare;

    // Se cerco la realtà, il surreale o il fantasy mi danno fastidio.
    RULE 3 : IF fantasia IS realistico
             AND (fantasia_film IS surreale OR fantasia_film IS fantasy)
             THEN affinita IS scartare;


    // -----------------------------------------------------------------
    // CASO 2: VOGLIO UN TOCCO ARTISTICO (User: STILIZZATO)
    // -----------------------------------------------------------------

    // Cerco un'estetica curata (es. Wes Anderson), realtà leggermente alterata.
    RULE 4 : IF fantasia IS stilizzato
             AND fantasia_film IS stilizzato
             THEN affinita IS imperdibile;

    // Accetto volentieri sia il realismo (se ben fatto) sia il surreale (se artistico).
    // Sono flessibile verso i vicini.
    RULE 5 : IF fantasia IS stilizzato
             AND (fantasia_film IS realistico OR fantasia_film IS surreale)
             THEN affinita IS considerare;

    // Il Fantasy puro (es. spade e stregoneria) è spesso troppo diverso dallo "stile" che cerco.
    RULE 6 : IF fantasia IS stilizzato
             AND fantasia_film IS fantasy
             THEN affinita IS scartare;


    // -----------------------------------------------------------------
    // CASO 3: VOGLIO IL SOGNO/ONIRICO (User: SURREALE)
    // -----------------------------------------------------------------

    // Cerco logiche da sogno, simbolismi, cose strane (es. Lynch).
    RULE 7 : IF fantasia IS surreale
             AND fantasia_film IS surreale
             THEN affinita IS imperdibile;

    // Un film Fantasy va bene (è comunque irreale), e uno Stilizzato va bene (è visivo).
    RULE 8 : IF fantasia IS surreale
             AND (fantasia_film IS stilizzato OR fantasia_film IS fantasy)
             THEN affinita IS considerare;

    // Il realismo puro è noioso per me in questo momento.
    RULE 9 : IF fantasia IS surreale
             AND fantasia_film IS realistico
             THEN affinita IS scartare;


    // -----------------------------------------------------------------
    // CASO 4: VOGLIO EVASIONE TOTALE (User: FANTASY)
    // -----------------------------------------------------------------

    // Voglio mondi inventati, magia, sci-fi spinto.
    RULE 10 : IF fantasia IS fantasy
              AND fantasia_film IS fantasy
              THEN affinita IS imperdibile;

    // Il surreale può piacermi perché contiene elementi impossibili.
    RULE 11 : IF fantasia IS fantasy
              AND fantasia_film IS surreale
              THEN affinita IS considerare;

    // Se voglio vedere draghi o astronavi, il realismo o il solo stile visivo non mi bastano.
    RULE 12 : IF fantasia IS fantasy
              AND (fantasia_film IS realistico OR fantasia_film IS stilizzato)
              THEN affinita IS scartare;

END_RULEBLOCK

END_FUNCTION_BLOCK